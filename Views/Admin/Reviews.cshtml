@model IEnumerable<WebBanVLXD.Models.Review>
@{ ViewData["Title"] = "Quản lý Đánh giá"; Layout = "_AdminLayout"; }

<div class="card card-admin p-4">
    <h5 class="fw-bold mb-4">Đánh giá từ khách hàng</h5>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Sản phẩm</th><th>Người dùng</th><th>Sao</th><th>Bình luận</th><th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model) {
            <tr>
                <td><small>@r.ProductId</small></td>
                <td><b>@r.UserName</b></td>
                <td class="text-warning">
                    @for(int i=0; i<r.Rating; i++){ <i class="fa-solid fa-star"></i> }
                </td>
                <td>@r.Comment</td>
                <td>
                    <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Xóa đánh giá này?')">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>