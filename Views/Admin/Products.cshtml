@model IEnumerable<WebBanVLXD.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm";
    Layout = "_AdminLayout";
}
<div class="card card-admin p-4">
    <div class="d-flex justify-content-between mb-4">
        <h5 class="fw-bold">Danh sách sản phẩm</h5>
        <a asp-action="CreateProduct" class="btn btn-primary btn-sm">+ Thêm mới</a>
    </div>
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Ảnh</th><th>Tên</th><th>Giá</th><th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td><img src="@item.ImageUrl" width="50" class="rounded"></td>
                <td><b>@item.Name</b><br><small>@item.Category</small></td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>
                    <div class="d-flex gap-2">
                        <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-pen"></i></a>
                        <form asp-action="DeleteProduct" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>