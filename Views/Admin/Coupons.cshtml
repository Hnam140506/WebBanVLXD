@model IEnumerable<WebBanVLXD.Models.Coupon>
@{
    ViewData["Title"] = "Mã giảm giá";
    Layout = "_AdminLayout";
}

<div class="card card-admin p-4">
    <div class="d-flex justify-content-between mb-4">
        <h5 class="fw-bold">Danh sách mã giảm giá</h5>
        <a asp-action="CreateCoupon" class="btn btn-orange text-white fw-bold">
            + Tạo mã mới
        </a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Mã Code</th>
                <th>Số tiền giảm</th>
                <th>Hết hạn</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td class="fw-bold text-primary">@c.Code</td>
                <td>@c.DiscountAmount.ToString("N0") đ</td>
                <td>@c.ExpiryDate.ToString("dd/MM/yyyy")</td>
                <td>@(c.IsActive ? "Đang chạy" : "Tạm dừng")</td>

                <td>
                    <form asp-action="DeleteCoupon" method="post"
                          onsubmit="return confirm('Xóa mã này?')">

                        <input type="hidden" name="id" value="@c.Id" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            <i class="fa-solid fa-trash"></i>
                        </button>

                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>