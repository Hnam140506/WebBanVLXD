@model List<WebBanVLXD.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container my-5">
    <h3 class="fw-bold mb-4" style="color: var(--bs-dark-blue);">Giỏ hàng của bạn</h3>

    @if (Model.Count > 0) {
        <div class="row">
            <!-- Cột trái: Danh sách sản phẩm trong giỏ -->
            <div class="col-lg-8">
                <div class="table-responsive shadow-sm rounded-3">
                    <table class="table align-middle bg-white mb-0">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giá</th>
                                <th style="width: 120px;">Số lượng</th>
                                <th>Tổng</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.Product.ImageUrl" style="width: 50px; height: 50px;" class="rounded me-3" />
                                            <span class="fw-bold">@item.Product.Name</span>
                                        </div>
                                    </td>
                                    <td>@item.Product.Price.ToString("N0") đ</td>
                                    <td>@item.Quantity @item.Product.Unit</td>
                                    <td class="fw-bold text-orange">@((item.Product.Price * item.Quantity).ToString("N0")) đ</td>
                                    <td>
                                        <a asp-action="Remove" asp-route-productId="@item.Product.Id" class="text-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt giỏ hàng (Đã sửa lại để link sang trang Checkout) -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-receipt me-2"></i>Tóm tắt giỏ hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Tạm tính:</span>
                        <span>@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") đ</span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Tổng tiền:</span>
                        <h4 class="text-orange fw-bold">@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") đ</h4>
                    </div>
                    
                    <!-- Nút này dùng thẻ <a> để gọi lệnh GET sang trang Checkout -->
                    <a href="/Cart/Checkout" class="btn btn-orange w-100 fw-bold text-white py-3 rounded-pill shadow-sm fs-5 text-decoration-none text-center">
                        TIẾN HÀNH THANH TOÁN
                    </a>
                </div>
            </div>
        </div>
    } else {
        <div class="text-center py-5">
            <i class="fa-solid fa-cart-shopping fs-1 text-muted mb-3"></i>
            <h5>Giỏ hàng đang trống</h5>
            <a href="/Product" class="btn btn-primary mt-3 rounded-pill px-4">Tiếp tục mua hàng</a>
        </div>
    }
</div>