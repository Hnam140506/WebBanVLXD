@model List<WebBanVLXD.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container my-5">
    <h3 class="fw-bold mb-4" style="color: var(--bs-dark-blue);">Giỏ hàng của bạn</h3>

    @if (Model.Count > 0) {
        <div class="row">
            <div class="col-lg-8">
                <div class="table-responsive shadow-sm rounded-3">
                    <table class="table align-middle bg-white mb-0">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giá</th>
                                <th style="width: 120px;">Số lượng</th>
                                <th>Tổng</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.Product.ImageUrl" style="width: 50px; height: 50px;" class="rounded me-3" />
                                            <span class="fw-bold">@item.Product.Name</span>
                                        </div>
                                    </td>
                                    <td>@item.Product.Price.ToString("N0") đ</td>
                                    <td>@item.Quantity @item.Product.Unit</td>
                                    <td class="fw-bold text-orange">@((item.Product.Price * item.Quantity).ToString("N0")) đ</td>
                                    <td>
                                        <a asp-action="Remove" asp-route-productId="@item.Product.Id" class="text-danger"><i class="fa-solid fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Form Thanh toán -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light">
                    <h5 class="fw-bold mb-3">Thông tin nhận hàng</h5>
                    <form asp-action="Checkout" method="post">
                        <div class="mb-3">
                            <label class="small fw-bold">Họ tên</label>
                            <input type="text" name="customerName" class="form-control" required value="@User.Identity?.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold">Số điện thoại</label>
                            <input type="tel" name="phone" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold">Địa chỉ giao hàng</label>
                            <textarea name="address" class="form-control" rows="2" required></textarea>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tổng tiền:</span>
                            <h4 class="text-orange fw-bold">@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") đ</h4>
                        </div>
                        <button type="submit" class="btn btn-orange w-100 fw-bold text-white py-3 rounded-3 shadow-sm">
                            ĐẶT HÀNG NGAY
                        </button>
                    </form>
                </div>
            </div>
        </div>
    } else {
        <div class="text-center py-5">
            <i class="fa-solid fa-cart-shopping fs-1 text-muted mb-3"></i>
            <h5>Giỏ hàng đang trống</h5>
            <a href="/Product" class="btn btn-primary mt-3">Tiếp tục mua hàng</a>
        </div>
    }
</div>