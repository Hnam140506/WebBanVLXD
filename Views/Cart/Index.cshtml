@model List<WebBanVLXD.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container my-5">
    <h3 class="fw-bold mb-4" style="color: var(--bs-dark-blue);">Giỏ hàng của bạn</h3>

    @if (Model.Count > 0) {
        <div class="row">
            <!-- Cột trái: Danh sách sản phẩm trong giỏ -->
            <div class="col-lg-8">
                <div class="table-responsive shadow-sm rounded-3">
                    <table class="table align-middle bg-white mb-0">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giá</th>
                                <th style="width: 140px;">Số lượng</th>
                                <th>Tổng</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <!-- Ưu tiên lấy ảnh phân loại, nếu không có mới lấy ảnh gốc -->
                                            <img src="@(item.ImageUrl ?? item.Product.ImageUrl)" style="width: 60px; height: 60px;" class="rounded me-3 object-fit-cover" />
                                            <div>
                                                <span class="fw-bold d-block text-dark">@item.Product.Name</span>
                                                <!-- Hiện tên phân loại nếu khách có chọn -->
                                                @if (!string.IsNullOrEmpty(item.VariantName))
                                                {
                                                    <span class="badge bg-light text-dark border mt-1">Phân loại: @item.VariantName</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-bold">@item.Price.ToString("N0") đ</td>
                                    <td>
                                        <!-- Form Tăng/Giảm Số Lượng dùng JavaScript để bấm chuẩn xác -->
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center cart-qty-form" style="width: 120px;">
                                            <input type="hidden" name="productId" value="@item.Product.Id" />
                                            <input type="hidden" name="variantId" value="@item.VariantId" />
                                            
                                            <!-- Nút Trừ (-) -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary px-2 btn-minus">-</button>
                                            
                                            <!-- Ô input số lượng -->
                                            <input type="number" name="quantity" value="@item.Quantity" class="form-control form-control-sm text-center mx-1 fw-bold qty-input" min="1" />
                                            
                                            <!-- Nút Cộng (+) -->
                                            <button type="button" class="btn btn-sm btn-outline-secondary px-2 btn-plus">+</button>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-orange">@((item.Price * item.Quantity).ToString("N0")) đ</td>
                                    <td>
                                        <!-- Nút xóa có truyền đủ cả ProductId và VariantId -->
                                        <a asp-action="Remove" asp-route-productId="@item.Product.Id" asp-route-variantId="@item.VariantId" class="text-danger">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt giỏ hàng -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-receipt me-2"></i>Tóm tắt giỏ hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Tạm tính:</span>
                        <span>@Model.Sum(i => i.Price * i.Quantity).ToString("N0") đ</span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Tổng tiền:</span>
                        <h4 class="text-orange fw-bold">@Model.Sum(i => i.Price * i.Quantity).ToString("N0") đ</h4>
                    </div>
                    
                    <a href="/Cart/Checkout" class="btn btn-orange w-100 fw-bold text-white py-3 rounded-pill shadow-sm fs-5 text-decoration-none text-center">
                        TIẾN HÀNH THANH TOÁN
                    </a>
                </div>
            </div>
        </div>
    } else {
        <div class="text-center py-5">
            <i class="fa-solid fa-cart-shopping fs-1 text-muted mb-3"></i>
            <h5>Giỏ hàng đang trống</h5>
            <a href="/Product" class="btn btn-primary mt-3 rounded-pill px-4">Tiếp tục mua hàng</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Khi bấm nút Trừ (-)
            $('.btn-minus').click(function () {
                let form = $(this).closest('form');
                let input = form.find('.qty-input');
                let newVal = parseInt(input.val()) - 1;
                if (newVal >= 1) {
                    input.val(newVal);
                    form.submit();
                }
            });

            // Khi bấm nút Cộng (+)
            $('.btn-plus').click(function () {
                let form = $(this).closest('form');
                let input = form.find('.qty-input');
                let newVal = parseInt(input.val()) + 1;
                input.val(newVal);
                form.submit();
            });

            // Khi người dùng gõ trực tiếp số vào ô và rời khỏi ô đó (change)
            $('.qty-input').change(function () {
                let form = $(this).closest('form');
                if (parseInt($(this).val()) >= 1) {
                    form.submit();
                } else {
                    $(this).val(1);
                    form.submit();
                }
            });
        });
    </script>
}