@model WebBanVLXD.Models.Order
@{ ViewData["Title"] = "Đặt hàng thành công"; }

<div class="container my-5 text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <div class="mb-4">
                    <i class="fa-solid fa-circle-check text-success" style="font-size: 80px;"></i>
                </div>
                <h2 class="fw-bold text-dark mb-3">Đặt Hàng Thành Công!</h2>
                <p class="text-muted mb-4">Cảm ơn <b>@Model.CustomerName</b> đã tin tưởng mua sắm tại BuildSmart. Mã đơn hàng của bạn là <strong class="text-primary">#@Model.Id.Substring(0,8).ToUpper()</strong>.</p>
                
                <div class="bg-light p-3 rounded-3 mb-4 text-start small">
                    <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-orange fw-bold">@Model.TotalAmount.ToString("N0") đ</span></p>
                    <p class="mb-1"><strong>Thanh toán:</strong> @(Model.PaymentMethod == "COD" ? "Thanh toán tiền mặt khi nhận hàng" : "Chuyển khoản ngân hàng")</p>
                    <p class="mb-0"><strong>Giao đến:</strong> @Model.Address</p>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a href="/Product" class="btn btn-outline-primary px-4 rounded-pill">Tiếp tục mua sắm</a>
                    <a href="/" class="btn btn-orange text-white px-4 rounded-pill fw-bold">Về trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</div>