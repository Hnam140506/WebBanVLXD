@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-4">
        <div class="card shadow border-0 p-4 rounded-4">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark">Quên mật khẩu</h3>
                <p class="text-muted small">Nhập email của bạn để nhận mã xác nhận OTP khôi phục mật khẩu.</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Địa chỉ Email</label>
                    <input type="email" name="email" class="form-control" placeholder="Nhập email của bạn..." required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-bold">Gửi mã OTP</button>
            </form>

            <div class="text-center mt-4 small">
                <span class="text-muted">Đã nhớ lại mật khẩu?</span>
                <a asp-action="Login" class="text-decoration-none fw-bold ms-1">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>