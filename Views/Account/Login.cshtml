@{
	ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="row justify-content-center mt-5">
	<div class="col-md-4">
		<div class="card shadow border-0 p-4">
			<div class="text-center mb-4">
				<h2 class="fw-bold text-dark">Chào mừng trở lại</h2>
				<p class="text-muted small">Đăng nhập để tiếp tục mua sắm vật liệu xây dựng</p>
			</div>

			<form asp-action="Login" method="post">
				<div class="text-danger small mb-3" asp-validation-summary="ModelOnly"></div>

				<div class="mb-3">
					<label class="form-label fw-bold small">Địa chỉ Email</label>
					<input type="email" name="email" class="form-control" placeholder="Nhập email của bạn..." required />
				</div>

				<div class="mb-3">
					<div class="d-flex justify-content-between">
						<label class="form-label fw-bold small">Mật khẩu</label>
						<a asp-action="ForgotPassword" asp-controller="Account" class="small text-decoration-none">Quên mật khẩu?</a>
					</div>
					<input type="password" name="password" class="form-control" placeholder="••••••••" required />
				</div>

				<button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-bold">Đăng nhập</button>
			</form>

			<div class="d-flex align-items-center my-4">
				<div class="flex-grow-1 border-bottom"></div>
				<span class="mx-3 text-muted small">Hoặc đăng nhập bằng</span>
				<div class="flex-grow-1 border-bottom"></div>
			</div>

			<form asp-action="ExternalLogin" asp-controller="Account" method="post" class="d-flex flex-column gap-2 mb-3">
				<button type="submit" name="provider" value="Google" class="btn btn-outline-danger fw-bold shadow-sm d-flex justify-content-center align-items-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16"><path d="M15.545 6.558a9.4 9.4 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.7 7.7 0 0 1 5.352 2.082l-2.284 2.284A4.35 4.35 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.8 4.8 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.7 3.7 0 0 0 1.599-2.431H8v-3.08h7.545z" /></svg>
					Tiếp tục với Google
				</button>
				<button type="submit" name="provider" value="Facebook" class="btn btn-primary fw-bold shadow-sm d-flex justify-content-center align-items-center">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-facebook me-2" viewBox="0 0 16 16"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951" /></svg>
					Tiếp tục với Facebook
				</button>
			</form>

			<div class="text-center mt-4 small">
				<span class="text-muted">Chưa có tài khoản?</span>
				<a asp-action="Register" class="text-decoration-none fw-bold ms-1">Đăng ký thành viên mới</a>
			</div>
		</div>
	</div>
</div>