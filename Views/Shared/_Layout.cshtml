<!DOCTYPE html>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using WebBanVLXD.Models
@{
    // Lấy đường dẫn hiện tại của trình duyệt để làm sáng menu tương ứng
    var currentPath = Context.Request.Path.ToString().ToLower();

    // TÍNH TỔNG SỐ LƯỢNG SẢN PHẨM TRONG GIỎ HÀNG
    int cartCount = 0;
    var sessionCart = Context.Session.GetString("Cart");
    if (!string.IsNullOrEmpty(sessionCart))
    {
        var cart = JsonConvert.DeserializeObject<List<CartItem>>(sessionCart);
        if (cart != null)
        {
            cartCount = cart.Sum(item => item.Quantity);
        }
    }
}
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildSmart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <!-- TOP BAR -->
    <div class="top-bar text-white py-2" style="background-color: var(--bs-dark-blue); font-size: 0.85rem;">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-4"><i class="fa-solid fa-phone me-1"></i> Hotline: 1900 123 456</span>
                <span><i class="fa-solid fa-envelope me-1"></i> contact@buildsmart.vn</span>
            </div>
            <div>
                <a href="/Order/Track">Tra cứu đơn hàng</a>
                <a href="#" class="text-white text-decoration-none">Hệ thống cửa hàng</a>
            </div>
        </div>
    </div>

    <!-- HEADER & NAVBAR -->
    <header class="bg-white py-3 sticky-top shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Logo -->
            <a href="/" class="text-decoration-none d-flex align-items-center">
                <i class="fa-solid fa-cubes-stacked fs-3 me-2" style="color: var(--bs-orange);"></i>
                <h4 class="mb-0 fw-bold" style="color: var(--bs-dark-blue); letter-spacing: 0.5px;">BUILDSMART</h4>
            </a>

            <!-- Navigation -->
            <nav class="d-none d-lg-block">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath == "/" || currentPath == "/home" || currentPath == "/home/index" ? "active" : "text-dark")"
                           href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath.StartsWith("/product") ? "active" : "text-dark")"
                           href="/Product">Sản phẩm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath.StartsWith("/projects") ? "active" : "text-dark")"
                           href="/Projects">Dự án</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath.StartsWith("/quote") ? "active" : "text-dark")"
                           href="/Quote">Báo giá</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath.StartsWith("/contact") ? "active" : "text-dark")"
                           href="/Contact">Liên hệ</a>
                    </li>
                </ul>
            </nav>

            <!-- Search -->
            <div class="d-none d-md-block" style="width: 250px;">
                <form class="input-group" asp-controller="Home" asp-action="Search" method="get">
                    <span class="input-group-text bg-light border-0 rounded-start-pill ps-3">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="query" class="form-control bg-light border-0 rounded-end-pill shadow-none"
                           placeholder="Tìm kiếm..." style="font-size: 0.9rem;">
                </form>
            </div>

            <!-- User & Cart Icons -->
            <div class="d-flex align-items-center gap-4">
                <a href="/Cart" class="position-relative text-dark text-decoration-none">
                    <i class="fa-solid fa-cart-shopping fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-orange text-white"
                          style="font-size: 0.65rem; padding: 0.35em 0.5em;">@cartCount</span>
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <a href="#" class="text-dark dropdown-toggle text-decoration-none d-flex align-items-center"
                           id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user fs-5 me-2"></i>
                            <span class="fw-bold small d-none d-md-inline">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" aria-labelledby="userMenu">
                            <li><span class="dropdown-item-text text-muted small">Chào, <b>@User.Identity.Name</b></span></li>
                            <li><hr class="dropdown-divider"></li>
                            
                            @* LINK HỒ SƠ MỚI *@
                            <li><a class="dropdown-item" href="/Account/Profile"><i class="fa-solid fa-address-card me-2"></i>Thông tin cá nhân</a></li>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item fw-bold text-primary" href="/Admin"><i class="fa-solid fa-chart-line me-2"></i>Dashboard Admin</a></li>
                                <li><hr class="dropdown-divider"></li>
                            }

                            <li><a class="dropdown-item" href="/Account/ChangePassword"><i class="fa-solid fa-key me-2"></i>Đổi mật khẩu</a></li>
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="text-dark text-decoration-none d-flex align-items-center">
                        <i class="fa-solid fa-user fs-5 me-2"></i>
                        <span class="small fw-bold">Đăng nhập</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="pt-5 pb-3 mt-5 footer-custom text-white" style="background-color: var(--bs-dark-blue);">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-3 col-md-6">
                    <a href="/" class="text-decoration-none d-flex align-items-center mb-3 text-white">
                        <i class="fa-solid fa-cubes-stacked fs-3 me-2 text-orange"></i>
                        <h5 class="mb-0 fw-bold">BUILDSMART</h5>
                    </a>
                    <p class="text-light opacity-75 small">Giải pháp vật liệu xây dựng toàn diện cho mọi công trình.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Sản phẩm</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>Sắt thép</li><li>Xi măng</li><li>Gạch xây</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Hỗ trợ</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>Bảo hành</li><li>Vận chuyển</li><li>Thanh toán</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Liên hệ</h6>
                    <p class="small opacity-75 mb-1"><i class="fa-solid fa-location-dot me-2"></i>Quận 1, TP. HCM</p>
                    <p class="small opacity-75"><i class="fa-solid fa-phone me-2"></i>1900 123 456</p>
                </div>
            </div>
            <div class="text-center pt-4 border-top border-secondary small opacity-50">
                &copy; 2024 BuildSmart - Cung cấp Vật Liệu Xây Dựng.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>