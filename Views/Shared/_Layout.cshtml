<!DOCTYPE html>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using WebBanVLXD.Models
@{
    // Lấy đường dẫn hiện tại của trình duyệt để làm sáng menu tương ứng
    var currentPath = Context.Request.Path.ToString().ToLower();

    // TÍNH TỔNG SỐ LƯỢNG SẢN PHẨM TRONG GIỎ HÀNG
    int cartCount = 0;
    var sessionCart = Context.Session.GetString("Cart");
    if (!string.IsNullOrEmpty(sessionCart))
    {
        var cart = JsonConvert.DeserializeObject<List<CartItem>>(sessionCart);
        if (cart != null)
        {
            cartCount = cart.Sum(item => item.Quantity);
        }
    }
}
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildSmart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <style>
        /* CSS cho dropdown Mini Cart tự động mở khi hover */
        @@media (min-width: 992px) {
            .cart-dropdown:hover .dropdown-menu {
                display: block;
                margin-top: 0;
                animation: fadeIn 0.2s ease-in-out;
            }
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Thêm phần này để giỏ hàng nảy lên mượt mà */
        #cartDropdownTrigger {
            display: inline-block;
            transition: transform 0.2s ease-in-out;
        }
    </style>
</head>

<!-- THÊM CÁC CLASS d-flex flex-column min-vh-100 VÀO THẺ BODY -->
<body class="d-flex flex-column min-vh-100">
    <!-- TOP BAR -->
<div class="top-bar text-white py-2" style="background-color: var(--bs-dark-blue); font-size: 0.85rem;">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <span class="me-4"><i class="fa-solid fa-phone me-1"></i> Hotline: 1900 123 456</span>
            <span class="d-none d-sm-inline"><i class="fa-solid fa-envelope me-1"></i> contact@buildsmart.vn</span>
        </div>
        <div>
            <!-- LÀM NỔI BẬT TRA CỨU ĐƠN HÀNG TẠI ĐÂY -->
            <a href="/Order/Track" class="btn-track-order">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Tra cứu đơn hàng
            </a>
        </div>
    </div>
</div>

    <!-- HEADER & NAVBAR -->
    <header class="bg-white py-3 sticky-top shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Logo -->
            <a href="/" class="text-decoration-none d-flex align-items-center">
                <i class="fa-solid fa-cubes-stacked fs-3 me-2" style="color: var(--bs-orange);"></i>
                <h4 class="mb-0 fw-bold" style="color: var(--bs-dark-blue); letter-spacing: 0.5px;">BUILDSMART</h4>
            </a>

            <!-- Navigation -->
            <nav class="d-none d-lg-block">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath == "/" || currentPath == "/home" || currentPath == "/home/index" ? "active" : "text-dark")"
                           href="/">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath.StartsWith("/product") ? "active" : "text-dark")"
                           href="/Product">Sản phẩm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-medium nav-link-custom @(currentPath.StartsWith("/contact") ? "active" : "text-dark")"
                           href="/Contact">Liên hệ</a>
                    </li>
                </ul>
            </nav>

            <!-- Search -->
            <div class="d-none d-md-block" style="width: 250px;">
                <form class="input-group" action="/" method="get"> <!-- Action trỏ về trang chủ -->
                    <span class="input-group-text bg-light border-0 rounded-start-pill ps-3">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" name="query" class="form-control bg-light border-0 rounded-end-pill shadow-none"
                        placeholder="Tìm kiếm sản phẩm..." style="font-size: 0.9rem;" value="@ViewBag.Query">
                </form>
            </div>

            <!-- User & Cart Icons -->
            <div class="d-flex align-items-center gap-4">
                <!-- User & Cart Icons -->
            <div class="d-flex align-items-center gap-4">
                
                <!-- BẮT ĐẦU: MINI CART THAY THẾ ICON CŨ -->
                <div class="dropdown cart-dropdown d-inline-block">
                    <a href="/Cart" class="position-relative text-dark text-decoration-none py-2" id="cartDropdownTrigger">
                        <i class="fa-solid fa-cart-shopping fs-5"></i>
                        <span id="global-cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-orange text-white"
                              style="font-size: 0.65rem; padding: 0.35em 0.5em;">@cartCount</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 rounded-4 mt-2" style="width: 320px;" id="miniCartContent">
                        <!-- Nội dung mini cart sẽ được load qua AJAX vào đây -->
                        <div class="text-center p-3 text-muted small"><div class="spinner-border spinner-border-sm text-orange"></div> Đang tải...</div>
                    </div>
                </div>
                <!-- KẾT THÚC: MINI CART -->

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <a href="#" class="text-dark dropdown-toggle text-decoration-none d-flex align-items-center"
                           id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user fs-5 me-2"></i>
                            <span class="fw-bold small d-none d-md-inline">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" aria-labelledby="userMenu">
                            <li><span class="dropdown-item-text text-muted small">Chào, <b>@User.Identity.Name</b></span></li>
                            <li><hr class="dropdown-divider"></li>
                            
                            <li><a class="dropdown-item" href="/Account/Profile"><i class="fa-solid fa-address-card me-2"></i>Thông tin cá nhân</a></li>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item fw-bold text-primary" href="/Admin"><i class="fa-solid fa-chart-line me-2"></i>Dashboard Admin</a></li>
                                <li><hr class="dropdown-divider"></li>
                            }

                            <li><a class="dropdown-item" href="/Account/ChangePassword"><i class="fa-solid fa-key me-2"></i>Đổi mật khẩu</a></li>
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="text-dark text-decoration-none d-flex align-items-center">
                        <i class="fa-solid fa-user fs-5 me-2"></i>
                        <span class="small fw-bold">Đăng nhập</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- THÊM CLASS flex-grow-1 VÀO THẺ MAIN -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="pt-5 pb-3 footer-custom text-white" style="background-color: var(--bs-dark-blue);">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-3 col-md-6">
                    <a href="/" class="text-decoration-none d-flex align-items-center mb-3 text-white">
                        <i class="fa-solid fa-cubes-stacked fs-3 me-2 text-orange"></i>
                        <h5 class="mb-0 fw-bold">BUILDSMART</h5>
                    </a>
                    <p class="text-light opacity-75 small">Giải pháp vật liệu xây dựng toàn diện cho mọi công trình.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Sản phẩm</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>Sắt thép</li><li>Xi măng</li><li>Gạch xây</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Hỗ trợ</h6>
                    <ul class="list-unstyled small opacity-75">
                        <li>Bảo hành</li><li>Vận chuyển</li><li>Thanh toán</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold mb-3">Liên hệ</h6>
                    <p class="small opacity-75 mb-1"><i class="fa-solid fa-location-dot me-2"></i>Quận 1, TP. HCM</p>
                    <p class="small opacity-75"><i class="fa-solid fa-phone me-2"></i>1900 123 456</p>
                </div>
            </div>
            <div class="text-center pt-4 border-top border-secondary small opacity-50">
                &copy; 2024 BuildSmart - Cung cấp Vật Liệu Xây Dựng.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="cartToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-bold">
                    <i class="fa-solid fa-circle-check me-2"></i> <span id="toastMessage">Sản phẩm đã được thêm vào giỏ!</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script>
        // Hàm nạp Mini Cart
        function loadMiniCart() {
            $.get('/Cart/GetMiniCart', function (data) {
                $('#miniCartContent').html(data);
            });
        }

        // Nạp Mini Cart lần đầu khi load trang
        $(document).ready(function () {
            loadMiniCart();
        });

        // Hàm gọi AJAX chung để thêm vào giỏ
        function addToCartAjax(productId, quantity) {
            $.post('/Cart/AddToCartAjax', { productId: productId, quantity: quantity }, function (res) {
                if (res.success) {
                    $('#global-cart-count').text(res.cartCount);
                    $('#toastMessage').text(res.message);
                    var toast = new bootstrap.Toast(document.getElementById('cartToast'));
                    toast.show();
                    loadMiniCart();
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
</body>

</html>