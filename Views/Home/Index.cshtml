@model IEnumerable<WebBanVLXD.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container-fluid p-0 mb-5">
    <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 400px; background: url('https://images.unsplash.com/photo-1541888086425-d81bb19240f5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover;">
        <div class="text-center text-white" style="background: rgba(0, 51, 102, 0.7); padding: 40px; border-radius: 10px;">
            <h1 class="display-4 fw-bold text-uppercase" style="color: var(--primary-yellow);">Siêu sale vật liệu</h1>
            <p class="fs-4">Giảm giá lên đến 30% cho các đơn hàng thép và xi măng</p>
            <a href="/Products" class="btn btn-custom btn-lg mt-3 px-5 rounded-pill">Mua ngay</a>
        </div>
    </div>
</div>

<div class="container">
    <h3 class="text-center fw-bold text-uppercase mb-4" style="color: var(--primary-blue);">Danh mục nổi bật</h3>
    <div class="row text-center justify-content-center mb-5">
        @{
            var categories = new[] { 
                new { Name = "Xi măng", Icon = "fa-cubes-stacked" },
                new { Name = "Sắt thép", Icon = "fa-bars" },
                new { Name = "Gạch ốp lát", Icon = "fa-border-all" },
                new { Name = "Sơn chống thấm", Icon = "fa-fill-drip" },
                new { Name = "Thiết bị", Icon = "fa-hammer" }
            };
        }
        @foreach(var cat in categories)
        {
            <div class="col-4 col-md-2 mb-3">
                <a href="/Products?category=@cat.Name" class="text-decoration-none text-dark">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 shadow-sm" style="width: 100px; height: 100px; border: 2px solid var(--primary-yellow);">
                        <i class="fa-solid @cat.Icon fs-1" style="color: var(--primary-blue);"></i>
                    </div>
                    <span class="fw-bold">@cat.Name</span>
                </a>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-uppercase m-0" style="color: var(--primary-blue);">Sản phẩm bán chạy</h3>
        <a href="/Products" class="text-decoration-none fw-bold" style="color: var(--primary-yellow);">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
    </div>

    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model.Take(8)) // Lấy 8 sp demo
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card h-100">
                        <div class="position-relative">
                            <img src="@(item.ImageUrl ?? "https://placehold.co/400x300/e9ecef/495057?text=No+Image")" class="card-img-top object-fit-cover" height="200" alt="@item.Name">
                            <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 m-2 rounded small fw-bold">HOT</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="text-muted small mb-1">@item.Category</p>
                            <h6 class="card-title fw-bold text-truncate">@item.Name</h6>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="product-price">@item.Price.ToString("N0") đ</span>
                                <button class="btn btn-custom btn-sm rounded-circle" style="width: 35px; height: 35px;" title="Thêm vào giỏ hàng">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                <p class="text-muted">Chưa có sản phẩm nào trong hệ thống.</p>
            </div>
        }
    </div>
</div>