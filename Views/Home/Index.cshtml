@model IEnumerable<WebBanVLXD.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container-fluid p-0 mb-5">
    <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 400px; background: url('https://images.unsplash.com/photo-1541888086425-d81bb19240f5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover;">
        <div class="text-center text-white" style="background: rgba(0, 51, 102, 0.7); padding: 40px; border-radius: 10px;">
            <h1 class="display-4 fw-bold text-uppercase" style="color: var(--primary-yellow);">Siêu sale vật liệu</h1>
            <p class="fs-4">Giảm giá lên đến 30% cho các đơn hàng thép và xi măng</p>
            <a href="/Products" class="btn btn-custom btn-lg mt-3 px-5 rounded-pill">Mua ngay</a>
        </div>
    </div>
</div>

<div class="container">
    <h3 class="text-center fw-bold text-uppercase mb-5" style="color: var(--primary-blue);">Danh mục nổi bật</h3>
    
    @await Component.InvokeAsync("FeaturedCategory")

    <div class="d-flex justify-content-between align-items-center mb-4 mt-5">
        <h3 class="fw-bold text-uppercase m-0" style="color: var(--primary-blue);">Sản phẩm nổi bật</h3>
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none fw-bold" style="color: var(--primary-yellow);">Xem tất cả <i class="fa-solid fa-angle-right"></i></a>
    </div>

    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-3">
                    <div class="card product-card h-100 shadow-sm border-0 position-relative">
                        <div class="position-relative overflow-hidden" style="height: 200px;">
                            <img src="@(item.ImageUrl ?? "https://placehold.co/400x300/e9ecef/495057?text=No+Image")" class="card-img-top object-fit-cover" height="200" alt="@item.Name">
                            <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 m-2 rounded small fw-bold">HOT</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="text-muted small mb-1">@item.Category</p>
                            <h6 class="card-title fw-bold text-truncate" title="@item.Name">@item.Name</h6>
                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="product-price fw-bold text-danger">@item.Price.ToString("N0") đ</span>
                                <button class="btn btn-custom btn-sm rounded-circle shadow-sm" style="width: 35px; height: 35px;" title="Thêm vào giỏ hàng">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                <p class="text-muted">Không tìm thấy sản phẩm nào thuộc danh mục này.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">Quay lại tất cả sản phẩm</a>
            </div>
        }
    </div>
</div>