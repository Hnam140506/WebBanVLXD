@model IEnumerable<WebBanVLXD.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
    var query = ViewBag.Query as string;
}

<!-- CHỈ HIỆN BANNER VÀ DANH MỤC KHI KHÔNG TÌM KIẾM -->
@if (string.IsNullOrEmpty(query))
{
    <!-- HERO SECTION -->
    <div class="hero-section position-relative">
        <div class="hero-bg" style="background: linear-gradient(to right, rgba(23, 62, 126, 0.95) 45%, rgba(23, 62, 126, 0.6) 100%), url('https://images.pexels.com/photos/159306/construction-site-build-construction-structure-159306.jpeg?auto=compress&cs=tinysrgb&w=1920') center/cover;">
            <div class="container h-100 d-flex align-items-center">
                <div class="row w-100">
                    <div class="col-lg-6 text-white py-5">
                        <span class="badge rounded-pill border border-light text-light px-3 py-2 mb-4 d-inline-flex align-items-center" style="background: rgba(255,255,255,0.05); font-weight: 500; font-size: 0.75rem; letter-spacing: 1px;">
                            <i class="fa-solid fa-circle text-orange me-2" style="font-size: 6px;"></i> GIẢI PHÁP TOÀN DIỆN
                        </span>
                        <h1 class="display-4 fw-bolder mb-4" style="line-height: 1.2;">
                            Vật Liệu Xây Dựng<br> Chất Lượng Cho<br>
                            <span class="text-orange">Mọi Công Trình</span>
                        </h1>
                        <div class="d-flex gap-3">
                            <a href="/Product" class="btn btn-orange fw-bold px-4 py-3 rounded-pill text-white shadow-sm d-inline-flex align-items-center">
                                Xem Sản Phẩm <i class="fa-solid fa-arrow-right ms-2"></i>
                            </a>
                            <a href="/Contact" class="btn btn-outline-light fw-bold px-4 py-3 rounded-pill">Liên Hệ Tư Vấn</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CATEGORY SECTION (ĐÃ KHÔI PHỤC ĐẦY ĐỦ 5 DANH MỤC) -->
    <div class="container my-5 pt-5 pb-4">
        <div class="d-flex justify-content-between align-items-end mb-4 pb-2">
            <div>
                <h3 class="fw-bold text-dark mb-2">Danh Mục Nổi Bật</h3>
                <p class="text-muted mb-0">Khám phá các dòng sản phẩm chất lượng cao của chúng tôi</p>
            </div>
            <a href="/Product" class="text-dark fw-medium text-decoration-none">
                Xem tất cả danh mục <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
            <!-- 1. Sắt thép -->
            <div class="col">
                <a href="/Product?category=Sắt+thép+xây+dựng" class="card category-img-card text-white border-0 text-decoration-none shadow-sm h-100">
                    <img src="https://cokhitudongchiho.com/wp-content/uploads/2018/02/thep-cuon-1.jpg" class="card-img h-100 object-fit-cover" alt="Sắt Thép">
                    <div class="card-img-overlay d-flex flex-column justify-content-end gradient-overlay p-3">
                        <h6 class="card-title fw-bold m-0">Sắt Thép</h6>
                    </div>
                </a>
            </div>

            <!-- 2. Xi măng, Cát, Đá -->
            <div class="col">
                <a href="/Product?category=Xi+măng,+Cát,+Đá" class="card category-img-card text-white border-0 text-decoration-none shadow-sm h-100">
                    <img src="https://images.pexels.com/photos/2219024/pexels-photo-2219024.jpeg?auto=compress&cs=tinysrgb&w=500" class="card-img h-100 object-fit-cover" alt="Xi măng">
                    <div class="card-img-overlay d-flex flex-column justify-content-end gradient-overlay p-3">
                        <h6 class="card-title fw-bold m-0">Xi măng, Cát, Đá</h6>
                    </div>
                </a>
            </div>

            <!-- 3. Gạch xây dựng -->
            <div class="col">
                <a href="/Product?category=Gạch+xây+dựng" class="card category-img-card text-white border-0 text-decoration-none shadow-sm h-100">
                    <img src="https://gachviglacera.vn/wp-content/uploads/2025/03/gach-xay-dung.jpg" class="card-img h-100 object-fit-cover" alt="Gạch xây">
                    <div class="card-img-overlay d-flex flex-column justify-content-end gradient-overlay p-3">
                        <h6 class="card-title fw-bold m-0">Gạch Xây Dựng</h6>
                    </div>
                </a>
            </div>

            <!-- 4. Sơn & Chống thấm -->
            <div class="col">
                <a href="/Product?category=Sơn+%26+Chống+thấm" class="card category-img-card text-white border-0 text-decoration-none shadow-sm h-100">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT3P7nswH_hOcbl7c8NKYPGEuvxv388p2JLFE_YL6bVcYJLETsIUF6zA1w&s=10" class="card-img h-100 object-fit-cover" alt="Sơn">
                    <div class="card-img-overlay d-flex flex-column justify-content-end gradient-overlay p-3">
                        <h6 class="card-title fw-bold m-0">Sơn & Chống Thấm</h6>
                    </div>
                </a>
            </div>

            <!-- 5. Gạch ốp lát -->
            <div class="col">
                <a href="/Product?category=Gạch+ốp+lát" class="card category-img-card text-white border-0 text-decoration-none shadow-sm h-100">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRQO0fHBcwWPbVjfU1pPwVaWg0iBn9v4SUmq7f6NWZY8GIspoLtXvEh19I&s=10" class="card-img h-100 object-fit-cover" alt="Gạch ốp">
                    <div class="card-img-overlay d-flex flex-column justify-content-end gradient-overlay p-3">
                        <h6 class="card-title fw-bold m-0">Gạch Ốp Lát</h6>
                    </div>
                </a>
            </div>
        </div>
    </div>
}

<!-- PHẦN HIỂN THỊ SẢN PHẨM (KẾT QUẢ TÌM KIẾM HOẶC SẢN PHẨM MỚI) -->
<div class="container my-5">
    @if (!string.IsNullOrEmpty(query))
    {
        <h3 class="fw-bold mb-4">Kết quả tìm kiếm cho: <span class="text-orange">"@query"</span></h3>
    }
    else
    {
        <h3 class="fw-bold mb-4 text-dark">Sản phẩm mới nhất</h3>
    }

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card-smart">
                        <div style="height: 200px; background: #f8f9fa;">
                            <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.Name">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted">@item.Category</small>
                            <h6 class="fw-bold text-dark text-truncate-2" style="min-height: 2.8rem;">@item.Name</h6>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="text-orange fw-bold fs-5">@item.Price.ToString("N0") đ</span>
                                <a href="/Product/Details/@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-magnifying-glass fs-1 text-muted mb-3"></i>
                <h5 class="text-muted">Không tìm thấy sản phẩm nào khớp với từ khóa của bạn.</h5>
                <a href="/" class="btn btn-orange text-white mt-3 rounded-pill px-4">Quay lại trang chủ</a>
            </div>
        }
    </div>
</div>