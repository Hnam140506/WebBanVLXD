@model IEnumerable<WebBanVLXD.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO SECTION -->
<div class="hero-section position-relative">
    <div class="hero-bg" style="background: linear-gradient(to right, rgba(23, 62, 126, 0.95) 45%, rgba(23, 62, 126, 0.6) 100%), url('https://images.unsplash.com/photo-1541888086425-d81bb19240f5?q=80&w=1920&auto=format&fit=crop') center/cover;">
        <div class="container h-100 d-flex align-items-center">
            <div class="row w-100">
                <div class="col-lg-6 text-white py-5">
                    <span class="badge rounded-pill border border-light text-light px-3 py-2 mb-4 d-inline-flex align-items-center" style="background: rgba(255,255,255,0.05); font-weight: 500; font-size: 0.75rem; letter-spacing: 1px;">
                        <i class="fa-solid fa-circle text-orange me-2" style="font-size: 6px;"></i> GIẢI PHÁP TOÀN DIỆN
                    </span>
                    <h1 class="display-4 fw-bolder mb-4" style="line-height: 1.2;">
                        Vật Liệu Xây Dựng<br>
                        Chất Lượng Cho<br>
                        <span class="text-orange">Mọi Công Trình</span>
                    </h1>
                    <p class="fs-6 mb-5" style="max-width: 480px; color: #d0d7e6; line-height: 1.6;">
                        Cung cấp giải pháp vật liệu toàn diện, giao hàng nhanh chóng, giá cả cạnh tranh. Đối tác tin cậy của hơn 1000+ nhà thầu.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="/Product" class="btn btn-orange fw-bold px-4 py-3 rounded-pill text-white shadow-sm d-inline-flex align-items-center">
                            Xem Sản Phẩm <i class="fa-solid fa-arrow-right ms-2"></i>
                        </a>
                        <a href="/Quote" class="btn btn-outline-light fw-bold px-4 py-3 rounded-pill" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                            Nhận Báo Giá
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CATEGORY SECTION -->
<div class="container my-5 pt-5 pb-4">
    <div class="d-flex justify-content-between align-items-end mb-4 pb-2">
        <div>
            <h3 class="fw-bold text-dark mb-2">Danh Mục Nổi Bật</h3>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">Khám phá các dòng sản phẩm chất lượng cao của chúng tôi</p>
        </div>
        <a href="/Product" class="text-dark fw-medium text-decoration-none" style="font-size: 0.95rem;">
            Xem tất cả danh mục <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
    </div>

    <!-- Sử dụng Row Cols 5 để tạo ra 5 cột bằng nhau trên màn hình lớn như trong thiết kế -->
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
        <div class="col">
            <a href="/Product?category=Sắt+Thép" class="card category-img-card text-white border-0 text-decoration-none">
                <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=400&auto=format&fit=crop" class="card-img h-100 object-fit-cover" alt="Sắt Thép">
                <div class="card-img-overlay d-flex flex-column justify-content-end align-items-start gradient-overlay">
                    <i class="fa-solid fa-layer-group mb-2 fs-5 opacity-75"></i>
                    <h6 class="card-title fw-bold m-0">Sắt Thép</h6>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/Product?category=Xi+Măng" class="card category-img-card text-white border-0 text-decoration-none">
                <img src="https://images.unsplash.com/photo-1621252179027-94459d278660?q=80&w=400&auto=format&fit=crop" class="card-img h-100 object-fit-cover" alt="Xi Măng">
                <div class="card-img-overlay d-flex flex-column justify-content-end align-items-start gradient-overlay">
                    <i class="fa-solid fa-bag-shopping mb-2 fs-5 opacity-75"></i>
                    <h6 class="card-title fw-bold m-0">Xi Măng</h6>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/Product?category=Gạch+Xây" class="card category-img-card text-white border-0 text-decoration-none">
                <img src="https://images.unsplash.com/photo-1585145199676-e17f0dd6ecf9?q=80&w=400&auto=format&fit=crop" class="card-img h-100 object-fit-cover" alt="Gạch Xây">
                <div class="card-img-overlay d-flex flex-column justify-content-end align-items-start gradient-overlay">
                    <i class="fa-solid fa-cubes mb-2 fs-5 opacity-75"></i>
                    <h6 class="card-title fw-bold m-0">Gạch Xây</h6>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/Product?category=Vật+Liệu+Hoàn+Thiện" class="card category-img-card text-white border-0 text-decoration-none">
                <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=400&auto=format&fit=crop" class="card-img h-100 object-fit-cover" alt="Vật Liệu Hoàn Thiện">
                <div class="card-img-overlay d-flex flex-column justify-content-end align-items-start gradient-overlay">
                    <i class="fa-solid fa-paint-roller mb-2 fs-5 opacity-75"></i>
                    <h6 class="card-title fw-bold m-0">Vật Liệu Hoàn Thiện</h6>
                </div>
            </a>
        </div>
        <div class="col">
            <a href="/Product?category=Thiết+Bị+Điện+Nước" class="card category-img-card text-white border-0 text-decoration-none">
                <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?q=80&w=400&auto=format&fit=crop" class="card-img h-100 object-fit-cover" alt="Thiết Bị Điện Nước">
                <div class="card-img-overlay d-flex flex-column justify-content-end align-items-start gradient-overlay">
                    <i class="fa-solid fa-bolt mb-2 fs-5 opacity-75"></i>
                    <h6 class="card-title fw-bold m-0">Thiết Bị Điện Nước</h6>
                </div>
            </a>
        </div>
    </div>
</div>