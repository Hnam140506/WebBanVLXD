@page
@model WebBanVLXD.Pages.Product.IndexModel
@{
    ViewData["Title"] = Model.Category;
}

<style>
    .old-price { text-decoration: line-through; color: #999; font-size: 0.9rem; margin-left: 8px; }
    .discount-badge { position: absolute; top: 10px; left: 10px; background-color: #ff3b30; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; z-index: 2; }
    .page-link { color: var(--primary-blue); }
    .page-item.active .page-link { background-color: var(--primary-yellow); border-color: var(--primary-yellow); color: var(--primary-blue); font-weight: bold; }
</style>

<div class="container my-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Product" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Category</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Component.InvokeAsync("ProductFilter", new { currentCategory = Model.Category })
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center bg-white p-3 shadow-sm rounded mb-4">
                <h4 class="mb-0 fw-bold" style="color: var(--primary-blue);">@Model.Category</h4>
                <div class="d-flex align-items-center">
                    <span class="me-2 text-muted small">Sắp xếp theo:</span>
                    <select class="form-select form-select-sm w-auto border-0 bg-light" onchange="location = this.value;">
                        <option value="/Product?category=@Model.Category" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Mặc định</option>
                        <option value="/Product?category=@Model.Category&sortOrder=price_asc" selected="@(Model.SortOrder == "price_asc")">Giá từ thấp đến cao</option>
                        <option value="/Product?category=@Model.Category&sortOrder=price_desc" selected="@(Model.SortOrder == "price_desc")">Giá từ cao đến thấp</option>
                    </select>
                </div>
            </div>

            <div class="row g-4 mb-5">
                @if (Model.Products != null && Model.Products.Any())
                {
                    foreach (var item in Model.Products)
                    {
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="card product-card h-100 position-relative">
                                <div class="discount-badge">-10%</div>
                                <img src="@(item.ImageUrl ?? "https://placehold.co/400x400/e9ecef/495057?text=No+Image")" class="card-img-top object-fit-cover" height="250" alt="@item.Name">
                                <div class="card-body d-flex flex-column">
                                    <p class="text-muted small mb-1">@item.Category</p>
                                    <h6 class="card-title fw-bold text-truncate">@item.Name</h6>
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-end">
                                        <div>
                                            <div class="product-price mb-0">@item.Price.ToString("N0") đ</div>
                                            <div class="old-price">@((item.Price * 1.1m).ToString("N0")) đ</div>
                                        </div>
                                        <button class="btn btn-custom btn-sm rounded-circle shadow-sm" style="width: 40px; height: 40px;">
                                            <i class="fa-solid fa-cart-shopping"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 bg-white shadow-sm rounded">
                        <i class="fa-solid fa-box-open fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Không tìm thấy sản phẩm nào</h4>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link" href="/Product?category=@Model.Category&pageNumber=@(Model.PageNumber - 1)">Trang trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="/Product?category=@Model.Category&pageNumber=@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="/Product?category=@Model.Category&pageNumber=@(Model.PageNumber + 1)">Trang sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>