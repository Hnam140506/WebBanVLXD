@page
@model WebBanVLXD.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Tất cả sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none small">Trang chủ</a></li>
            <li class="breadcrumb-item active small" aria-current="page">@Model.Category</li>
        </ol>
        <h3 class="fw-bold mt-2">
            <span style="color: var(--bs-dark-blue);">Vật Liệu Xây Dựng</span>
            <span class="text-orange">Chất Lượng Cao</span>
        </h3>
    </nav>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="filter-sidebar bg-white p-4 rounded-3 shadow-sm border sticky-top" style="top: 100px;">
                <h6 class="fw-bold mb-3"><i class="fa-solid fa-layer-group me-2"></i> Danh mục</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><a href="/Product" class="text-decoration-none @(Model.Category == "Tất cả sản phẩm" ? "text-orange fw-bold" : "text-muted")">Tất cả sản phẩm</a></li>
                    <li class="mb-2"><a href="/Product?category=Sắt+thép+xây+dựng" class="text-decoration-none @(Model.Category == "Sắt thép xây dựng" ? "text-orange fw-bold" : "text-muted")">Sắt thép xây dựng</a></li>
                    <li class="mb-2"><a href="/Product?category=Xi+măng" class="text-decoration-none @(Model.Category == "Xi măng" ? "text-orange fw-bold" : "text-muted")">Xi măng, Cát, Đá</a></li>
                    <li class="mb-2"><a href="/Product?category=Gạch+xây+dựng" class="text-decoration-none @(Model.Category == "Gạch xây dựng" ? "text-orange fw-bold" : "text-muted")">Gạch xây dựng</a></li>
                    <li class="mb-2"><a href="/Product?category=Sơn+%26+Chống+thấm" class="text-decoration-none @(Model.Category == "Sơn & Chống thấm" ? "text-orange fw-bold" : "text-muted")">Sơn & Chống thấm</a></li>
                    <li class="mb-2"><a href="/Product?category=Gạch+ốp+lát" class="text-decoration-none @(Model.Category == "Gạch ốp lát" ? "text-orange fw-bold" : "text-muted")">Gạch ốp lát</a></li>
                </ul>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4" id="product-list-container">
                @if (Model.Products != null && Model.Products.Any()) {
                    @foreach (var item in Model.Products) {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                                <div style="height: 180px; background-color: #f8f9fa;">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/400x300" : item.ImageUrl)" class="w-100 h-100 object-fit-cover">
                                </div>
                                <div class="card-body p-3 d-flex flex-column">
                                    <small class="text-muted">@item.Category</small>
                                    <h6 class="fw-bold mt-1">@item.Name</h6>
                                    <div class="mt-auto">
                                        <div class="text-orange fw-bold fs-5 mb-2">@item.Price.ToString("N0") đ</div>
                                        <a href="/Product/Details/@item.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill">XEM CHI TIẾT</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                } else {
                    <div class="col-12 text-center py-5"><h5>Không tìm thấy sản phẩm.</h5></div>
                }
            </div>
        </div>
    </div>
</div>