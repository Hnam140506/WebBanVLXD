@page "{id}"
@model WebBanVLXD.Pages.Product.DetailsModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row g-5">
        <!-- SLIDER TRƯỢT ẢNH -->
        <div class="col-lg-6">
            <div id="slider" class="carousel slide shadow rounded-4 overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (Model.Product.Images != null && Model.Product.Images.Any())
                    {
                        @for (int i = 0; i < Model.Product.Images.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.Product.Images[i].Url" class="d-block w-100"
                                     style="height: 450px; object-fit: cover;">
                            </div>
                        }
                    }
                    else
                    {
                        <div class="carousel-item active">
                            <img src="@Model.Product.ImageUrl" class="d-block w-100"
                                 style="height: 450px; object-fit: cover;">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" data-bs-target="#slider" data-bs-slide="prev"><span
                    class="carousel-control-prev-icon"></span></button>
                    <button class="carousel-control-next" data-bs-target="#slider" data-bs-slide="next"><span
                        class="carousel-control-next-icon"></span></button>
                    </div>
                </div>

                <!-- THÔNG TIN & CHỌN BIẾN THỂ -->
                <div class="col-lg-6">
                    <h2 class="fw-bold">@Model.Product.Name</h2>

                    <div class="text-warning mb-3">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i
                            class="fa-@(i <= Model.Product.AverageRating ? "solid" : "regular") fa-star"></i>
                        }
                        <span class="text-muted small ms-2">(@Model.Product.Reviews.Count đánh giá)</span>
                    </div>

                    <h3 class="text-orange fw-bold" id="price">
                        @(Model.Product.Variants.Any() ? "Chọn phiên bản" : Model.Product.Price.ToString("N0") + " đ")
                    </h3>

                    <!-- FORM ĐẶT HÀNG TRUYỀN DỮ LIỆU SANG CART -->
                    <form action="/Cart/AddToCart" method="post">
                        <input type="hidden" name="productId" value="@Model.Product.Id" />

                        @if (Model.Product.Variants.Any())
                        {
                            <div class="mt-4">
                                <label class="fw-bold mb-2">Chọn loại:</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (var v in Model.Product.Variants)
                                    {
                                        <input type="radio" class="btn-check" name="variantId" id="@v.Id" value="@v.Id"
                                               data-price="@v.Price" data-stock="@v.StockQuantity" data-img="@v.ImageUrl"
                                               onchange="updateSelection(this)" required>
                                        <label class="btn btn-outline-primary" for="@v.Id">@v.Name</label>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mt-4">
                            @if (Model.Product.Variants.Any())
                            {
                                <p id="stock" class="fw-bold"></p>
                            }
                            else
                            {
                                <p id="stock" class="fw-bold @(Model.Product.StockQuantity > 0 ? "text-success" : "text-danger")">
                                    @(Model.Product.StockQuantity > 0 ? $"Còn hàng: {Model.Product.StockQuantity}" : "Hết hàng")
                                </p>
                            }

                            <div class="d-flex gap-3 align-items-center mt-3">
                                <input type="number" name="quantity" id="quantityInput" value="1" min="1"
                                       max="@(Model.Product.Variants.Any() ? "" : Model.Product.StockQuantity.ToString())"
                                       class="form-control text-center fw-bold" style="width: 80px;" required>

                                <!-- NÚT THÊM VÀO GIỎ HÀNG -->
                                <button type="submit" name="submitAction" value="add" id="addToCart"
                                        class="btn btn-outline-primary btn-lg px-4 fw-bold shadow-sm" @(Model.Product.Variants.Any()
                                                                                    || Model.Product.StockQuantity <= 0 ? "disabled" : "")>
                                    <i class="fa-solid fa-cart-plus"></i> THÊM VÀO GIỎ
                                </button>

                                <!-- NÚT MUA NGAY -->
                                <button type="submit" name="submitAction" value="buy" id="buyNow"
                                        class="btn btn-orange btn-lg text-white px-5 fw-bold shadow-sm"
                                    @(Model.Product.Variants.Any() || Model.Product.StockQuantity <= 0 ? "disabled" : "")>
                                    MUA NGAY
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- CHI TIẾT SẢN PHẨM Ở DƯỚI -->
            <div class="row mt-5">
                <div class="col-12">
                    <ul class="nav nav-tabs custom-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#desc">Mô tả sản
                                phẩm</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#reviews">Đánh giá
                                    (@Model.Product.Reviews.Count)</button>
                                </li>
                            </ul>
                            <div class="tab-content p-4 bg-white shadow-sm rounded-bottom" id="myTabContent">
                                <!-- Tab Mô tả -->
                                <div class="tab-pane fade show active" id="desc">
                                    @if (!string.IsNullOrEmpty(Model.Product.Description))
                                    {
                                        @Html.Raw(Model.Product.Description.Replace("\n", "<br>"))
                                    }
                                    else
                                    {
                                        <p class="text-muted">Đang cập nhật nội dung mô tả...</p>
                                    }
                                </div>

                                     <!-- Tab Đánh giá -->
                                    <div class="tab-pane fade" id="reviews">
                                    <!-- DÁN ĐOẠN NÀY VÀO ĐỂ XEM LỖI NẰM Ở ĐÂU -->
                                    <div class="alert alert-secondary">
                                        <b>Dữ liệu kiểm tra:</b> 
                                        Hệ thống tìm thấy <b>@ViewData["Debug_Purchased"]</b> đơn hàng Hoàn thành của bạn 
                                        và bạn đã viết <b>@ViewData["Debug_Review"]</b> đánh giá.
                                    </div>
                                    
                                    @if (Model.CanReview)
                                    {
                                        <div class="card mb-4 shadow-sm border-0 bg-light p-3">
                                            <div class="card-body">
                                                <h5 class="fw-bold mb-3">Viết đánh giá của bạn</h5>
                                                <!-- Bắn về Handler OnPostAddReview trong PageModel -->
                                                <!-- Đã thêm asp-route-id vào thẻ form -->
                                                <!-- BẮT BUỘC phải có asp-page-handler="AddReview" để trỏ đúng vào hàm OnPostAddReviewAsync -->
                                                    <!-- CÁCH SỬA: Thêm asp-route-id="@Model.Product.Id" vào thẻ form -->
<!-- Dọn dẹp thẻ form lại đơn giản như thế này -->
<form method="post">
    
    @Html.AntiForgeryToken()
    
    <div class="mb-3">
        <label class="form-label">Mức độ hài lòng:</label>
        <select name="rating" class="form-select w-auto">
            <option value="5">⭐⭐⭐⭐⭐ - Tuyệt vời</option>
            <option value="4">⭐⭐⭐⭐ - Rất tốt</option>
            <option value="3">⭐⭐⭐ - Bình thường</option>
            <option value="2">⭐⭐ - Tạm được</option>
            <option value="1">⭐ - Rất tệ</option>
        </select>
    </div>

    <div class="mb-3">
        <textarea name="comment" class="form-control" rows="3" placeholder="Chia sẻ cảm nhận của bạn về chất lượng sản phẩm..." required></textarea>
    </div>

    <!-- Xóa thuộc tính asp-page-handler ở nút submit -->
    <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
</form>
                                            </div>
                                        </div>
                                    }
                                    else if (User.Identity != null && User.Identity.IsAuthenticated)
                                    {
                                        <div class="alert alert-info">
                                            <i class="fa-solid fa-circle-info me-2"></i> Bạn cần mua sản phẩm này và đơn hàng được giao
                                            thành công để có thể đánh giá (hoặc bạn đã sử dụng hết lượt đánh giá tương ứng với số đơn hàng).
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            Vui lòng <a href="/Account/Login">đăng nhập</a> và mua hàng để được để lại đánh giá.
                                        </div>
                                    }

                                    <!-- Danh sách Reviews -->
                                    <div class="review-list mt-4">
                                        @if (Model.Product.Reviews.Any())
                                        {
                                            @foreach (var review in Model.Product.Reviews.OrderByDescending(r => r.CreatedAt))
                                            {
                                                <div class="border-bottom pb-3 mb-3">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <strong>@review.UserName <span class="badge bg-success ms-2 fw-normal"><i
                                                            class="fa-solid fa-check me-1"></i> Đã mua hàng</span></strong>
                                                            <span class="text-muted small">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                                        </div>
                                                        <div class="text-warning small mb-2">
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i
                                                                class="fa-@(i <= review.Rating ? "solid" : "regular") fa-star"></i>
                                                            }
                                                        </div>
                                                        <p class="mb-0">@review.Comment</p>
                                                    </div>
                                                }
                                            }
                        else
                                            {
                                                <p class="text-muted text-center py-4">Chưa có đánh giá nào cho sản phẩm này.</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <script>
    function updateSelection(radio) {
        // Cập nhật giá và tồn kho
        document.getElementById('price').innerText = parseFloat(radio.dataset.price).toLocaleString() + " đ";
        
        const stock = parseInt(radio.dataset.stock);
        const stockEl = document.getElementById('stock');
        const buyNowBtn = document.getElementById('buyNow');
        const addToCartBtn = document.getElementById('addToCart');
        const qtyInput = document.getElementById('quantityInput');

        if (stock > 0) {
            stockEl.innerHTML = `<span class="text-success">Còn hàng: ${stock}</span>`;
            buyNowBtn.disabled = false;
            addToCartBtn.disabled = false;
            qtyInput.max = stock; 
            
            if (parseInt(qtyInput.value) > stock) {
                qtyInput.value = stock;
            }
        } else {
            stockEl.innerHTML = `<span class="text-danger">Hết hàng</span>`;
            buyNowBtn.disabled = true;
            addToCartBtn.disabled = true;
            qtyInput.max = 1;
        }

        // TÍNH NĂNG CHUYỂN ẢNH KHI CLICK VÀO PHIÊN BẢN
        const imgUrl = radio.dataset.img;
        if (imgUrl && imgUrl.trim() !== '') {
            // Lấy thẻ <img> của slide đầu tiên trong carousel
            const firstSlideImg = document.querySelector('#slider .carousel-inner .carousel-item:first-child img');
            if(firstSlideImg) {
                // Thay đổi ảnh slide đầu tiên bằng ảnh của phiên bản
                firstSlideImg.src = imgUrl;
                
                // Kích hoạt Bootstrap Carousel quay về slide số 0
                const carouselElement = document.getElementById('slider');
                if (window.bootstrap && bootstrap.Carousel) {
                    const bsCarousel = bootstrap.Carousel.getInstance(carouselElement) || new bootstrap.Carousel(carouselElement);
                    bsCarousel.to(0);
                }
            }
        }
    }
</script>