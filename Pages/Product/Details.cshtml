@page "{id}"
@model WebBanVLXD.Pages.Product.DetailsModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="container my-5">
    <div class="row g-5">
        <!-- SLIDER TRƯỢT ẢNH -->
        <div class="col-lg-6">
            <div id="slider" class="carousel slide shadow rounded-4 overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Product.Images.Count; i++) {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Product.Images[i].Url" class="d-block w-100" style="height: 450px; object-fit: cover;">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" data-bs-target="#slider" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" data-bs-target="#slider" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            </div>
        </div>

        <!-- THÔNG TIN & CHỌN BIẾN THỂ -->
        <div class="col-lg-6">
            <h2 class="fw-bold">@Model.Product.Name</h2>
            
            <!-- Đánh giá thực tế từ Database -->
            <div class="text-warning mb-3">
                @for(int i=1; i<=5; i++){ <i class="fa-@(i <= Model.Product.AverageRating ? "solid" : "regular") fa-star"></i> }
                <span class="text-muted small ms-2">(@Model.Product.Reviews.Count đánh giá thật)</span>
            </div>

            <h3 class="text-orange fw-bold" id="price">Chọn phiên bản</h3>

            <div class="mt-4">
                <label class="fw-bold mb-2">Chọn loại:</label>
                <div class="d-flex gap-2">
                    @foreach (var v in Model.Product.Variants) {
                        <input type="radio" class="btn-check" name="v" id="@v.Id" data-price="@v.Price" data-stock="@v.StockQuantity" onchange="updateSelection(this)">
                        <label class="btn btn-outline-primary" for="@v.Id">@v.Name</label>
                    }
                </div>
            </div>

            <div class="mt-4">
                <p id="stock" class="fw-bold"></p>
                <div class="d-flex gap-3 align-items-center">
                    <input type="number" value="1" min="1" class="form-control" style="width: 80px;">
                    <button id="buy" class="btn btn-orange btn-lg text-white px-5" disabled>MUA NGAY</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function updateSelection(radio) {
        document.getElementById('price').innerText = parseFloat(radio.dataset.price).toLocaleString() + " đ";
        const stock = parseInt(radio.dataset.stock);
        const stockEl = document.getElementById('stock');
        const buyBtn = document.getElementById('buy');

        if (stock > 0) {
            stockEl.innerHTML = `<span class="text-success">Còn hàng: ${stock}</span>`;
            buyBtn.disabled = false;
        } else {
            stockEl.innerHTML = `<span class="text-danger">Hết hàng</span>`;
            buyBtn.disabled = true;
        }
    }
</script>