@page "{id}"
@model WebBanVLXD.Pages.Product.DetailsModel
@{
    ViewData["Title"] = Model.Product.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Tính phần trăm giảm giá
    var discountPercent = 0;
    if (Model.Product.OldPrice > Model.Product.Price && Model.Product.OldPrice > 0)
    {
        discountPercent = (int)Math.Round((1 - (Model.Product.Price / Model.Product.OldPrice)) * 100);
    }
}

<div class="container my-4">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/" class="text-muted text-decoration-none small">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Product" class="text-muted text-decoration-none small">Sản phẩm</a></li>
            <li class="breadcrumb-item"><a href="/Product?category=@Model.Product.Category" class="text-muted text-decoration-none small">@Model.Product.Category</a></li>
            <li class="breadcrumb-item active small text-dark fw-medium text-truncate" style="max-width: 300px;" aria-current="page">@Model.Product.Name</li>
        </ol>
    </nav>

    <!-- PRODUCT MAIN INFO -->
    <div class="row g-5 mb-5">
        <!-- Left Column: Images -->
        <div class="col-lg-5">
            <div class="product-gallery">
                <div class="main-image mb-3 bg-light rounded-3 overflow-hidden border" style="height: 450px;">
                    <img id="mainProductImage" src="@(Model.Product.ImageUrl ?? "https://placehold.co/800x800/e9ecef/495057?text=No+Image")" class="w-100 h-100 object-fit-cover" alt="@Model.Product.Name">
                </div>
                <div class="d-flex gap-2 overflow-auto pb-2 thumbnail-container">
                    <!-- Ảnh chính làm thumbnail -->
                    <div class="thumbnail active rounded-3 overflow-hidden border cursor-pointer flex-shrink-0" style="width: 80px; height: 80px;" onclick="changeMainImage(this, '@Model.Product.ImageUrl')">
                        <img src="@(Model.Product.ImageUrl ?? "https://placehold.co/800x800/e9ecef/495057?text=No+Image")" class="w-100 h-100 object-fit-cover">
                    </div>
                    <!-- Các thumbnail giả lập (do CSDL hiện tại chỉ có 1 link ảnh) -->
                    <div class="thumbnail rounded-3 overflow-hidden border cursor-pointer flex-shrink-0" style="width: 80px; height: 80px;" onclick="changeMainImage(this, 'https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=800&auto=format&fit=crop')">
                        <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=800&auto=format&fit=crop" class="w-100 h-100 object-fit-cover">
                    </div>
                    <div class="thumbnail rounded-3 overflow-hidden border cursor-pointer flex-shrink-0" style="width: 80px; height: 80px;" onclick="changeMainImage(this, 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=800&auto=format&fit=crop')">
                        <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?q=80&w=800&auto=format&fit=crop" class="w-100 h-100 object-fit-cover">
                    </div>
                    <div class="thumbnail rounded-3 overflow-hidden border cursor-pointer flex-shrink-0" style="width: 80px; height: 80px;" onclick="changeMainImage(this, 'https://images.unsplash.com/photo-1504307651254-35680f356f12?q=80&w=800&auto=format&fit=crop')">
                        <img src="https://images.unsplash.com/photo-1504307651254-35680f356f12?q=80&w=800&auto=format&fit=crop" class="w-100 h-100 object-fit-cover">
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Details -->
        <div class="col-lg-7">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="badge bg-light text-muted border px-2 py-1 fw-medium" style="font-size: 0.75rem;">
                    THƯƠNG HIỆU: <span style="color: var(--bs-dark-blue);">@(string.IsNullOrEmpty(Model.Product.Brand) ? "Đang cập nhật" : Model.Product.Brand.ToUpper())</span>
                </span>
                @if (Model.Product.StockQuantity > 0)
                {
                    <span class="text-success small fw-bold"><i class="fa-solid fa-check me-1"></i> CÒN HÀNG</span>
                }
                else
                {
                    <span class="text-danger small fw-bold"><i class="fa-solid fa-xmark me-1"></i> HẾT HÀNG</span>
                }
            </div>

            <h3 class="fw-bold mb-3" style="color: var(--bs-dark-blue); line-height: 1.4;">@Model.Product.Name</h3>

            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="text-warning me-2" style="font-size: 0.9rem;">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <span class="text-muted small me-3">42 Đánh giá</span>
                <span class="text-muted small border-start ps-3">1.2k Đã bán</span>
            </div>

            <!-- Price Box -->
            <div class="bg-light rounded-3 p-4 mb-4">
                <div class="d-flex align-items-end gap-3 mb-2">
                    <h2 class="text-orange fw-bold mb-0">@Model.Product.Price.ToString("N0") đ <span class="fs-5 text-muted fw-normal">/@Model.Product.Unit</span></h2>
                    @if (Model.Product.OldPrice > Model.Product.Price)
                    {
                        <span class="text-muted text-decoration-line-through fs-6 mb-1">@Model.Product.OldPrice.ToString("N0") đ/@Model.Product.Unit</span>
                        <span class="badge bg-danger mb-1">-@discountPercent%</span>
                    }
                </div>
                <p class="text-muted small mb-0 fst-italic">* Giá đã bao gồm thuế VAT. Miễn phí vận chuyển cho đơn hàng trên 50 triệu.</p>
            </div>

            <!-- Variants (Giả lập giao diện chọn kích thước) -->
            <div class="mb-4">
                <p class="fw-bold small mb-2 text-dark">Chọn kích thước (Đường kính):</p>
                <div class="d-flex gap-2 flex-wrap variant-selectors">
                    <input type="radio" class="btn-check" name="options" id="opt1" autocomplete="off" checked>
                    <label class="btn btn-outline-secondary btn-variant px-4 py-2" for="opt1">Ø6 mm</label>

                    <input type="radio" class="btn-check" name="options" id="opt2" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-variant px-4 py-2" for="opt2">Ø8 mm</label>

                    <input type="radio" class="btn-check" name="options" id="opt3" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-variant px-4 py-2" for="opt3">Ø10 mm</label>
                </div>
            </div>

            <!-- Quantity & Actions -->
            <div class="mb-5">
                <p class="fw-bold small mb-2 text-dark">Số lượng (@Model.Product.Unit):</p>
                <div class="d-flex align-items-center gap-4 mb-4">
                    <div class="input-group quantity-group" style="width: 140px;">
                        <button class="btn btn-light border text-dark fw-bold px-3" type="button" onclick="decreaseQty()">-</button>
                        <input type="number" id="qtyInput" class="form-control text-center border-start-0 border-end-0 fw-bold" value="500" min="1">
                        <button class="btn btn-light border text-dark fw-bold px-3" type="button" onclick="increaseQty()">+</button>
                    </div>
                    <span class="text-muted small">Tối thiểu: 100 @Model.Product.Unit</span>
                </div>

                <div class="d-flex gap-3">
                    <button class="btn btn-lg fw-bold px-4 shadow-sm" style="background-color: var(--bs-dark-blue); color: white;">
                        <i class="fa-solid fa-cart-shopping me-2"></i> THÊM VÀO GIỎ HÀNG
                    </button>
                    <button class="btn btn-orange btn-lg fw-bold px-5 shadow-sm text-white">
                        MUA NGAY
                    </button>
                </div>
            </div>

            <!-- Policy Grid -->
            <div class="row row-cols-2 g-3 pt-4 border-top">
                <div class="col d-flex align-items-center">
                    <i class="fa-solid fa-truck-fast text-muted fs-5 me-3"></i>
                    <span class="text-muted small">Giao hàng toàn quốc trong 24h</span>
                </div>
                <div class="col d-flex align-items-center">
                    <i class="fa-solid fa-shield-halved text-muted fs-5 me-3"></i>
                    <span class="text-muted small">Bảo hành chính hãng 12 tháng</span>
                </div>
                <div class="col d-flex align-items-center">
                    <i class="fa-solid fa-rotate-left text-muted fs-5 me-3"></i>
                    <span class="text-muted small">Đổi trả trong 7 ngày</span>
                </div>
                <div class="col d-flex align-items-center">
                    <i class="fa-solid fa-medal text-muted fs-5 me-3"></i>
                    <span class="text-muted small">Cam kết chất lượng đạt chuẩn</span>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTTOM TABS & SIDEBAR -->
    <div class="row g-5">
        <!-- Product Tabs -->
        <div class="col-lg-8">
            <ul class="nav nav-tabs custom-tabs mb-4 border-bottom-0" id="productTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button" role="tab">Thông số kỹ thuật</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">Mô tả sản phẩm</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="cert-tab" data-bs-toggle="tab" data-bs-target="#cert" type="button" role="tab">Chứng chỉ chất lượng</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="review-tab" data-bs-toggle="tab" data-bs-target="#review" type="button" role="tab">Đánh giá khách hàng</button>
                </li>
            </ul>
            <div class="tab-content" id="productTabContent">
                <!-- Tab: Specs -->
                <div class="tab-pane fade show active" id="specs" role="tabpanel">
                    <table class="table table-striped-columns table-borderless table-specs">
                        <tbody>
                            <tr>
                                <td class="text-muted py-3 ps-3 w-50">Thương hiệu</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">@(string.IsNullOrEmpty(Model.Product.Brand) ? "Tập đoàn Hòa Phát" : Model.Product.Brand)</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Mã sản phẩm</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">HP-CB240T</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Tiêu chuẩn</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">TCVN 1651-1:2018</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Giới hạn bền kéo (MPa)</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">≥ 380</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Giới hạn chảy (MPa)</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">≥ 240</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Độ giãn dài (%)</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">≈ 20</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Bề mặt</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">Bóng, trơn, không vết nứt</td>
                            </tr>
                            <tr>
                                <td class="text-muted py-3 ps-3">Đóng gói</td>
                                <td class="fw-bold text-dark py-3 text-end pe-3">Cuộn (1000kg - 2000kg)</td>
                            </tr>
                        </tbody>
                    </table>
                    
                    @if (!string.IsNullOrEmpty(Model.Product.Specifications))
                    {
                        <div class="mt-4">
                            <h6 class="fw-bold mb-3">Thông số khác từ nhà sản xuất:</h6>
                            <p class="text-muted">@Model.Product.Specifications</p>
                        </div>
                    }
                </div>

                <!-- Tab: Description -->
                <div class="tab-pane fade text-muted" id="desc" role="tabpanel" style="line-height: 1.8;">
                    <h5 class="fw-bold text-dark mb-4">Mô tả tóm tắt</h5>
                    @Html.Raw(Model.Product.Description.Replace("\n", "<br/>"))
                    
                    <!-- Nội dung giả lập thêm cho phần mô tả để giống thiết kế -->
                    <p class="mt-3">Thép cuộn là dòng thép xây dựng phổ biến nhất hiện nay, được sản xuất trên dây chuyền công nghệ hiện đại, đáp ứng mọi yêu cầu khắt khe của các công trình dân dụng và công nghiệp.</p>
                    <p>Sản phẩm có đặc tính dẻo dai, dễ uốn, được sử dụng rộng rãi trong việc làm cốt thép bê tông, lưới thép hàn, đai cột và nhiều hạng mục xây dựng khác.</p>
                    <ul>
                        <li>Độ bền cao, chịu lực tốt theo tiêu chuẩn Việt Nam.</li>
                        <li>Chống ăn mòn và oxy hóa trong điều kiện môi trường khắc nghiệt.</li>
                    </ul>
                </div>
                
                <div class="tab-pane fade" id="cert" role="tabpanel">
                    <p class="text-muted mt-3">Đang cập nhật chứng chỉ chất lượng...</p>
                </div>
                <div class="tab-pane fade" id="review" role="tabpanel">
                    <p class="text-muted mt-3">Chưa có đánh giá nào.</p>
                </div>
            </div>
        </div>

        <!-- Sidebar (Tư vấn & Khuyến mãi) -->
        <div class="col-lg-4">
            <!-- Consultant Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-4 d-flex align-items-center text-orange">
                        <i class="fa-solid fa-headset fs-5 me-2"></i> Tư vấn mua hàng
                    </h6>
                    
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="d-flex align-items-center">
                            <img src="https://placehold.co/100x100/e9ecef/495057?text=MQ" class="rounded-circle me-3" style="width: 50px; height: 50px;" alt="Avatar">
                            <div>
                                <h6 class="fw-bold mb-0" style="color: var(--bs-dark-blue);">Mr. Minh Quân</h6>
                                <span class="text-muted" style="font-size: 0.75rem;">Chuyên viên vật liệu thô</span>
                            </div>
                        </div>
                        <a href="tel:0900000000" class="btn btn-light rounded-circle text-orange p-2 shadow-sm"><i class="fa-solid fa-phone"></i></a>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="d-flex align-items-center">
                            <img src="https://placehold.co/100x100/e9ecef/495057?text=HL" class="rounded-circle me-3" style="width: 50px; height: 50px;" alt="Avatar">
                            <div>
                                <h6 class="fw-bold mb-0" style="color: var(--bs-dark-blue);">Mr. Hoàng Long</h6>
                                <span class="text-muted" style="font-size: 0.75rem;">Kỹ thuật công trình</span>
                            </div>
                        </div>
                        <a href="tel:0900000001" class="btn btn-light rounded-circle text-orange p-2 shadow-sm"><i class="fa-solid fa-phone"></i></a>
                    </div>

                    <button class="btn btn-outline-dark w-100 fw-bold rounded-3 py-2">YÊU CẦU GỌI LẠI</button>
                </div>
            </div>

            <!-- Project Banner -->
            <div class="card border-0 rounded-4 text-white p-4 text-center" style="background-color: var(--bs-dark-blue);">
                <p class="small text-warning fw-bold mb-2">DÀNH CHO DỰ ÁN</p>
                <h4 class="fw-bold mb-3">Bạn cần mua số lượng lớn?</h4>
                <p class="small mb-4" style="color: #9ab0d2;">Liên hệ phòng kinh doanh dự án để nhận chiết khấu lên đến 5-10%.</p>
                <button class="btn btn-light w-100 fw-bold rounded-3 py-2 text-dark">NHẬN BÁO GIÁ DỰ ÁN</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // JS Đổi ảnh chính khi click vào thumbnail
        function changeMainImage(element, imageUrl) {
            document.getElementById('mainProductImage').src = imageUrl;
            // Xóa class active ở tất cả thumbnail
            document.querySelectorAll('.thumbnail').forEach(function(thumb) {
                thumb.classList.remove('active', 'border-primary');
            });
            // Thêm active cho thumbnail được click
            element.classList.add('active', 'border-primary');
        }

        // JS Tăng giảm số lượng
        function increaseQty() {
            let input = document.getElementById('qtyInput');
            input.value = parseInt(input.value) + 1;
        }
        
        function decreaseQty() {
            let input = document.getElementById('qtyInput');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }
    </script>
}