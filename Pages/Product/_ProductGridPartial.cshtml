@model IEnumerable<WebBanVLXD.Models.Product>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col">
            <div class="card product-card-smart h-100 border-0 shadow-sm rounded-4">
                <!-- Badges -->
                @if (item.OldPrice > item.Price)
                {
                    <span class="product-badge badge bg-danger position-absolute top-0 start-0 m-3">-15%</span>
                }
                else if (item.StockQuantity < 10)
                {
                    <span class="product-badge badge bg-orange position-absolute top-0 start-0 m-3">BÁN CHẠY</span>
                }
                else if (item.CreatedAt > DateTime.Now.AddDays(-7))
                {
                    <span class="product-badge badge bg-primary position-absolute top-0 start-0 m-3">MỚI</span>
                }

                <!-- Image -->
                <div class="bg-light" style="border-radius: 1rem 1rem 0 0; overflow: hidden; height: 180px;">
                    <img src="@(item.ImageUrl ?? "https://placehold.co/400x300/e9ecef/495057?text=No+Image")" class="w-100 h-100 object-fit-cover" alt="@item.Name">
                </div>
                
                <!-- Content -->
                <div class="card-body d-flex flex-column p-4 position-relative">
                    <span class="brand-text text-muted mb-1" style="font-size: 0.75rem;">
                        @(string.IsNullOrEmpty(item.Brand) ? "Thương hiệu chung" : item.Brand)
                    </span>
                    <h6 class="product-title-smart fw-bold text-dark mb-2" style="font-size: 0.95rem; line-height: 1.4;">
                        @item.Name
                    </h6>
                    
                    <div class="rating-stars mb-3">
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.75rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.75rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.75rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.75rem;"></i>
                        <i class="fa-solid fa-star text-warning" style="font-size: 0.75rem;"></i>
                        <span class="text-muted ms-1" style="font-size: 0.75rem;">(12)</span>
                    </div>

                    <div class="mt-auto">
                        <div class="price-current text-orange fw-bold fs-6">@item.Price.ToString("N0") đ/@item.Unit</div>
                        @if (item.OldPrice > 0)
                        {
                            <div class="price-old text-muted text-decoration-line-through mt-1" style="font-size: 0.8rem;">
                                @item.OldPrice.ToString("N0") đ
                            </div>
                        }
                        else
                        {
                            <div class="mt-1" style="font-size: 0.8rem; visibility: hidden;">Placeholder</div>
                        }
                    </div>
                    
                    <!-- Cart Button -->
                    <button class="btn btn-cart-smart position-absolute shadow-sm" style="bottom: 1.5rem; right: 1.5rem; background-color: var(--bs-dark-blue); width: 35px; height: 35px; border-radius: 8px;">
                        <i class="fa-solid fa-cart-shopping text-white" style="font-size: 0.85rem;"></i>
                    </button>
                </div>
            </div>
        </div>
    }
}