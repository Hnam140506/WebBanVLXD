@model IEnumerable<WebBanVLXD.Models.Product>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white product-card-smart">
                <div style="height: 180px; background-color: #f8f9fa;">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.Name">
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                            <i class="fa-solid fa-image fa-3x"></i>
                        </div>
                    }
                </div>

                <div class="card-body p-3 d-flex flex-column">
                    <small class="text-muted d-block mb-1">@item.Category</small>
                    <h6 class="fw-bold text-dark mb-2 text-truncate-2" style="height: 2.8rem; overflow: hidden;">
                        @item.Name
                    </h6>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-orange fw-bold fs-5">@item.Price.ToString("N0") đ</span>
                            <small class="text-muted">/@item.Unit</small>
                        </div>
                        <a href="/Product/Details/@item.Id" class="btn btn-outline-primary btn-sm w-100 mt-3 rounded-pill fw-bold">
                            XEM CHI TIẾT
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}