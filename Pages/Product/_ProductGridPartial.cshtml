@model IEnumerable<WebBanVLXD.Models.Product>

@if (Model != null)
{
    foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                <!-- Ảnh -->
                <div style="height: 180px; background-color: #f1f1f1;">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@item.Name">
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                            <i class="fa-solid fa-image fa-3x"></i>
                        </div>
                    }
                </div>

                <!-- Thông tin -->
                <div class="card-body p-3">
                    <small class="text-muted d-block mb-1">@item.Category</small>
                    <h6 class="fw-bold text-dark mb-2 text-truncate-2" style="height: 2.8rem; overflow: hidden;">
                        @item.Name
                    </h6>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-orange fw-bold fs-5">@item.Price.ToString("N0") đ</span>
                        <small class="text-muted">/@item.Unit</small>
                    </div>
                    <a href="/Product/Details/@item.Id" class="btn btn-outline-primary btn-sm w-100 mt-3 rounded-pill">
                        Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Dòng này để bạn debug, nếu thấy nó hiện ra nghĩa là Model bị truyền vào sai -->
    <p class="text-danger">Lỗi: Dữ liệu sản phẩm bị trống!</p>
}